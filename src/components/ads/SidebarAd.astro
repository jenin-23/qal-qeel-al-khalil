---
import type { AdLayout, SidebarAd } from '../../lib/types';

interface Props {
  ad: SidebarAd;
  index?: number;
}
const LAYOUTS: AdLayout[] = ['notice', 'banner', 'checklist', 'reverse', 'coupon'];
const { ad, index = 0 } = Astro.props;
const layout = ad.layout ?? LAYOUTS[index % LAYOUTS.length];
---
<div class="ad-flyer" data-ad-layout={layout}>
  <div class="ad-brand">{ad.brand}</div>
  <div class="ad-body" set:html={ad.html} />
  <div class="ad-cta">{ad.cta}</div>
  <div class="ad-phones">
    {ad.phones.map((p) => (
      <button class="copy-phone-btn" type="button" data-phone={p.phone}>{p.label}</button>
    ))}
  </div>
</div>
