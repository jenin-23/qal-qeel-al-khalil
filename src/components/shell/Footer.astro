---
/* Colophon. Its links (من نحن · تواصل معنا · الأرشيف) always lead to
   the newspaper-level pages, whichever issue or page it is printed on. */
import type { Issue } from '../../lib/types';
import { newspaper } from '../../universe/newspaper';
import { paperUrl } from '../../lib/url';

interface Props {
  /** omitted on newspaper-level pages */
  issue?: Issue;
  pageKey: string;
  tagline?: string | null;
}
const { issue, pageKey, tagline } = Astro.props;

const links = newspaper.footerLinks.map((link) => ({ ...link, href: paperUrl(link.key as 'about' | 'contact' | 'archive' | 'broadcast') }));
const year = issue?.meta.year ?? new Date().getFullYear();
const copyright = issue?.meta.copyright ?? `© ${year} ${newspaper.name}`;
const city = issue ? issue.meta.city : newspaper.city;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-card">
      <div class="footer-top">
        <div class="footer-brand">
          <h3>{newspaper.name}</h3>
          {tagline && <p>{tagline}</p>}
        </div>

        <div class="footer-actions">
          {links.map((link) => (
            <a
              class:list={['footer-link', { active: link.key === pageKey }]}
              href={link.href}
              aria-current={link.key === pageKey ? 'page' : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>

      <div class="footer-bottom">
        <span>{copyright}</span>
        {city && <span>{city}</span>}
      </div>
    </div>
  </div>
</footer>
