---
/* ------------------------------------------------------------------ *
 * Masthead at the newspaper level (من نحن, تواصل معنا, the archive).
 * No issue is open here, so there are no issue ears and no issue
 * sections, only the paper's name and the library navigation.
 * ------------------------------------------------------------------ */
import { newspaper } from '../../universe/newspaper';
import { paperUrl } from '../../lib/url';

interface Props {
  pageKey: string;
}
const { pageKey } = Astro.props;
---
<header class="topbar">
  <div class="container">
    <div class="masthead masthead--paper">
      <div class="masthead-grid">
        <div class="brand-box">
          <div class="brand">{newspaper.name}</div>
          <p class="tagline">{newspaper.tagline}</p>
        </div>
      </div>

      <nav class="site-nav" aria-label={newspaper.name}>
        <div class="nav-wrap">
          <div class="nav-links">
            {newspaper.paperNav.map((item) => (
              <a
                class:list={['nav-link', { primary: item.key === pageKey }]}
                href={paperUrl(item.key)}
                aria-current={item.key === pageKey ? 'page' : undefined}
              >{item.label}</a>
            ))}
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>
