---
/* ------------------------------------------------------------------ *
 * DESIGN PROTOTYPE (not linked from anywhere, noindex).
 * Issue 001's news page, unchanged content, rendered with the proposed
 * "old Arabic newspaper" press theme. The real /issues/001/ pages keep
 * the classic theme until the prototype is approved.
 * ------------------------------------------------------------------ */
import '../../styles/press/index.css';
import IssueLayout from '../../layouts/IssueLayout.astro';
import Blocks from '../../components/blocks/Blocks.astro';
import { getIssue } from '../../lib/issues';

const issue = getIssue('001');
const page = issue.pages.news!;
---
<IssueLayout
  issue={issue}
  pageKey="news"
  docTitle={page.docTitle}
  ticker={page.ticker}
  footerTagline={page.footerTagline}
  theme="press"
  noindex
>
  <Blocks blocks={page.blocks} issue={issue} pageKey="news" />
</IssueLayout>
