---
/* ------------------------------------------------------------------ *
 * Old Issue-001 URLs (/news.html, /columns.html#habbab-story, …) were
 * shared before the archive existed. They forward to the frozen
 * /issues/001/ pages, keeping ?query and #article anchors.
 * (/index.html is the homepage itself; /archive.html still exists.)
 * ------------------------------------------------------------------ */
import type { GetStaticPaths } from 'astro';
import { getIssue } from '../lib/issues';
import { issueUrl } from '../lib/url';
import { LEGACY_ISSUE, LEGACY_PAGES } from '../lib/legacy';


export const getStaticPaths = (() => LEGACY_PAGES.map((legacy) => ({ params: { legacy } }))) satisfies GetStaticPaths;

const page = Astro.params.legacy!;
const target = issueUrl(LEGACY_ISSUE, page);
const title = getIssue(LEGACY_ISSUE).pages[page]!.docTitle;
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={new URL(target, Astro.site).href} />
  <script is:inline define:vars={{ target }}>
    location.replace(target + location.search + location.hash);
  </script>
  <meta http-equiv="refresh" content={`0; url=${target}`} />
</head>
<body>
  <a href={target}>{title}</a>
</body>
</html>
