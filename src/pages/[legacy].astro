---
/* ------------------------------------------------------------------ *
 * Old Issue-001 URLs (/news.html, /columns.html#habbab-story, …) were
 * shared before the archive existed. They forward to the frozen
 * /issues/001/ pages, keeping ?query and #article anchors.
 * (/about.html and /contact.html are newspaper-level pages now;
 *  /index.html is the library; /archive.html still exists.)
 * ------------------------------------------------------------------ */
import type { GetStaticPaths } from 'astro';
import Redirect from '../components/Redirect.astro';
import { getIssue } from '../lib/issues';
import { issueUrl } from '../lib/url';
import { LEGACY_ISSUE, LEGACY_PAGES } from '../lib/legacy';

export const getStaticPaths = (() => LEGACY_PAGES.map((legacy) => ({ params: { legacy } }))) satisfies GetStaticPaths;

const page = Astro.params.legacy!;
---
<Redirect target={issueUrl(LEGACY_ISSUE, page)} title={getIssue(LEGACY_ISSUE).pages[page]!.docTitle} />
