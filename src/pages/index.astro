---
/* ------------------------------------------------------------------ *
 * مكتبة قال قيل: the front door, and nothing but the front door.
 * No issue ever opens from here by itself: a reader takes one.
 *
 * Every public issue stands on the shelf (editing, published,
 * archived; never drafts), one shelf per year, oldest first, straight
 * from the registry. Unlabelled bundles of old paper are atmosphere,
 * never pretend issues. The editors' drawer waits on the storage shelf.
 * ------------------------------------------------------------------ */
import Document from '../layouts/Document.astro';
import ShelfNewspaper from '../components/library/ShelfNewspaper.astro';
import ArchiveDrawer from '../components/library/ArchiveDrawer.astro';
import Radio from '../components/radio/Radio.astro';
import { shelfIssues } from '../lib/issues';
import { paperUrl } from '../lib/url';
import { newspaper } from '../universe/newspaper';
import { library } from '../universe/library';

// one shelf per year
const years = [...new Set(shelfIssues.map((i) => i.meta.year))].sort((a, b) => a - b);
const shelves = years.map((year) => ({ year, issues: shelfIssues.filter((i) => i.meta.year === year) }));
const latestYear = years.at(-1) ?? new Date().getFullYear();
let index = 0;
---
<Document docTitle={`${library.name} | ${newspaper.name}`} pageKey="library" canonical={new URL(import.meta.env.BASE_URL, Astro.site).href} radio="none">
  <div class="library-room">
    <header class="library-plaque">
      <p class="library-brand">{newspaper.name}</p>
      <h1 class="library-title">{library.name}</h1>
      <p class="library-tagline">{newspaper.tagline}</p>
    </header>

    <!-- newspaper-level navigation only: issue sections appear once an issue is opened -->
    <nav class="library-nav" aria-label={library.name}>
      {newspaper.paperNav.map((item) => (
        <a
          class:list={['library-nav-link', { 'is-current': item.key === 'library' }]}
          href={paperUrl(item.key)}
          aria-current={item.key === 'library' ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="bookcase">
      {shelves.map((shelf, s) => (
        <section class="shelf-year" aria-labelledby={`shelf-${shelf.year}`}>
          <h2 class="shelf-year-label" id={`shelf-${shelf.year}`}>{shelf.year}</h2>
          <ol class="shelf">
            {shelf.issues.map((issue) => <ShelfNewspaper issue={issue} index={index++} />)}

            {s === shelves.length - 1 && (
              <Fragment>
                <li class="shelf-slot shelf-slot--decor" aria-hidden="true">
                  <span class="paper-bundle">
                    <span></span><span></span><span></span><span></span><span></span>
                    <span class="twine"></span>
                  </span>
                </li>
                <li class="shelf-slot shelf-slot--decor" aria-hidden="true">
                  <span class="paper-spines">
                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                  </span>
                  <span class="bookend"></span>
                </li>
              </Fragment>
            )}
          </ol>
        </section>
      ))}

      <!-- the storage shelf: old bundles, and the editors' drawer -->
      <div class="shelf shelf--storage">
        <span class="storage-group" aria-hidden="true">
          <span class="paper-bundle paper-bundle--low"><span></span><span></span><span></span><span class="twine"></span></span>
          <span class="paper-bundle"><span></span><span></span><span></span><span></span><span class="twine"></span></span>
        </span>
        <ArchiveDrawer />
        <!-- …and, noticed second, the radio -->
        <Radio variant="shelf" />
      </div>
    </div>

    <footer class="library-foot">
      <span>© {latestYear} {newspaper.name}</span>
      <span>{newspaper.city}</span>
    </footer>
  </div>
</Document>
