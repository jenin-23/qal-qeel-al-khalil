---
/* ------------------------------------------------------------------ *
 * The HTML document every page shares: head, fonts, paper effects and
 * the browser scripts. The library, each issue and the newsroom proof
 * all render inside it, so they are the same paper in the same world.
 * ------------------------------------------------------------------ */
import '../styles/index.css';
import PressEffects from '../components/press/PressEffects.astro';
import Radio from '../components/radio/Radio.astro';
import DevMark from '../components/shell/DevMark.astro';
import { PREVIEW, issues } from '../lib/issues';

interface Props {
  docTitle: string;
  /** body[data-page]: drives page-specific composition */
  pageKey: string;
  issueNumber?: string;
  canonical?: string;
  noindex?: boolean;
  /** Easter eggs this page enables (default: by page context) */
  eggs?: string[];
  /** extra Google Fonts families, merged into the one font request */
  extraFonts?: string[];
  /** the one radio on this page: at the desk side, or none (the library places its own) */
  radio?: 'desk' | 'none';
}
const { docTitle, pageKey, issueNumber, canonical, noindex = false, eggs, extraFonts = [], radio = 'desk' } = Astro.props;
// one render-blocking font stylesheet only: a second one disables cross-page View Transitions
const FAMILIES = ['Amiri:ital,wght@0,400;0,700;1,400', 'Noto+Naskh+Arabic:wght@400;500;600;700', 'Cairo:wght@500;700', 'Lalezar', ...extraFonts];
// newsroom builds: marked in the tab and on the page, and never indexed
const unreleased = issueNumber ? issues.find((i) => i.meta.number === issueNumber)?.meta.preview : undefined;
const title = PREVIEW ? `[تطوير] ${docTitle}` : docTitle;
const fontHref = `https://fonts.googleapis.com/css2?${FAMILIES.map((f) => 'family=' + f).join('&')}&display=swap`;
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  {(noindex || PREVIEW) && <meta name="robots" content="noindex" />}
  <slot name="head" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fontHref} />
</head>
<body data-page={pageKey} data-issue={issueNumber} data-eggs={eggs?.join(' ')}>
  <PressEffects />
  {PREVIEW && <DevMark status={unreleased} issueNumber={issueNumber} />}
  <slot />
  {radio === 'desk' && <Radio variant="desk" />}
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
